# ── Font ──────────────────────────────────────────────────────────────────────
# iTerm2: SauceCodeProNF 15
font-family = "SauceCodePro Nerd Font"
font-size = 13

# ── Window ────────────────────────────────────────────────────────────────────
# iTerm2: Transparency=0.147, Blur=true, BlurRadius=9.89
background-opacity = 0.85
background-blur-radius = 10
window-padding-x = 4
window-padding-y = 4
macos-titlebar-style = tabs

# ── Cursor ────────────────────────────────────────────────────────────────────
# iTerm2: Blinking=false, CursorType=default(block)
cursor-style = block
cursor-style-blink = false

# ── Scrollback ────────────────────────────────────────────────────────────────
# iTerm2: 1000
scrollback-limit = 1000

# ── Option key ────────────────────────────────────────────────────────────────
# iTerm2: Option Key Sends = Normal (0) → Option は Meta として使わない
macos-option-as-alt = false

# ── Colors (iTerm2 dark mode profile から抽出) ────────────────────────────────
background             = #14181d
foreground             = #7ffb4c
cursor-color           = #7ffb4c
cursor-text            = #ffffff
selection-background   = #b3d7ff
selection-foreground   = #101010

# ANSI colors (dark)
palette = 0=#14191e
palette = 1=#b43c29
palette = 2=#57bf37
palette = 3=#c7c400
palette = 4=#2743c7
palette = 5=#bf3fbd
palette = 6=#00c5c7
palette = 7=#c7c7c7
palette = 8=#676767
palette = 9=#dc7974
palette = 10=#57e690
palette = 11=#ece100
palette = 12=#a6aaf1
palette = 13=#e07de0
palette = 14=#5ffdff
palette = 15=#feffff

# ── Shell integration ─────────────────────────────────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ── Mouse ─────────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true

# ── Keybindings (iTerm2 風) ───────────────────────────────────────────────────
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+]=next_tab
keybind = cmd+shift+[=previous_tab
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+up=goto_split:up
keybind = cmd+opt+down=goto_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
